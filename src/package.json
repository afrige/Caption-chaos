{
"name": "caption-chaos",
"version": "1.0.0",
"description": "Caption Chaos",
"main": "src/main.js",
"author": "Nick",
"license": "MIT",
"scripts": {
  "start": "electron .",
  "server": "node server.js",
  "build": "electron-builder"

},
"dependencies": {
"discord-rpc": "^4.0.1",
"ws": "^8.18.3"
},
"devDependencies": {
"electron": "^38.1.0",
"electron-builder": "^26.0.12"
},
"build": {
"appId": "com.captionchaos.app",
"productName": "Caption Chaos",
"directories": {
"output": "dist"
},
"files": [
"src/**/*",
"assets/**/*",
"icon.ico",
"package.json"
],
"win": {
"target": [
{
"target": "nsis",
"arch": [
"x64"
]
}
],
"icon": "icon.ico"
},
"nsis": {
"oneClick": false,
"allowToChangeInstallationDirectory": true,
"createDesktopShortcut": true,
"createStartMenuShortcut": true
}
}
}
