{
"name": "caption-chaos",
"version": "1.0.0",
"description": "Caption Chaos",
"main": "src/main.js",
"scripts": {
"start": "electron .",
"server": "node server.js",
"build": "electron-builder"
},
"keywords": [],
"author": "Nick",
"license": "MIT",
"type": "commonjs",
"dependencies": {
"discord-rpc": "^4.0.1",
"express": "^4.21.2"
},
"devDependencies": {
"ws": "^8.18.3",
"electron": "^44.4.3",
"electron-builder": "^26.15.3"
},
"build": {
"appId": "com.captionchaos.app",
"productName": "Caption Chaos",
"directories": {
"output": "dist"
},
"files": [
"src/**/*",
"!src/package.json",
"assets/**/*",
"icon.ico",
"package.json"
],
"win": {
"target": [
{
"target": "nsis",
"arch": [
"x64"
]
}
],
"icon": "icon.ico"
},
"nsis": {
"oneClick": false,
"allowToChangeInstallationDirectory": true,
"createDesktopShortcut": true,
"createStartMenuShortcut": true
}
}
}
